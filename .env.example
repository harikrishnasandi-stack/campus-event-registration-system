# ==============================================================================
# Campus Event Management System - Environment Configuration Template
# Copy this file to .env or set environment variables in your terminal / IDE.
# DO NOT COMMIT REAL PASSWORDS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/campus_events?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication (HS256 secret key, minimum 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Server Port (default: 8080)
PORT=8080

# File Upload Directory
UPLOAD_DIR=./uploads/certificates

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Campus Timezone & Automated Notification Schedule
CAMPUS_TIMEZONE=Asia/Kolkata
NOTIFICATION_CRON=0 0 8 * * *

